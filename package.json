{
  "name": "test-captions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "api": "tsx watch src/api/server.ts",
    "worker": "tsx watch src/worker/index.ts",
    "start": "sh scripts/start.sh",
    "start:api": "node --import tsx/esm src/api/server.ts",
    "start:worker": "node --import tsx/esm src/worker/index.ts",
    "build": "tsc && npm run build:web",
    "build:web": "npm run build --workspace web",
    "dev:web": "npm run dev --workspace web",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/admin.ts create-user",
    "admin:list": "tsx scripts/admin.ts list-users",
    "admin:reset": "tsx scripts/admin.ts reset-password",
    "admin:claim": "tsx scripts/admin.ts claim-orphans"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/client-service-quotas": "^3.1029.0",
    "@aws-sdk/client-sts": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^9.1.3",
    "@remotion/bundler": "^4.0.448",
    "@remotion/lambda": "^4.0.448",
    "@remotion/renderer": "^4.0.448",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
